# Copier ce fichier vers .env et compléter. .env n'est jamais versionné.

# --- Environnement -----------------------------------------------------------
PHP_VERSION=8.1
WP_VERSION=latest
RCIPR_HTTP_PORT=8082
RCIPR_MAIL_PORT=8027
RCIPR_DB_PORT=3308

# --- Base de données (développement uniquement) ------------------------------
RCIPR_DB_NAME=wordpress
RCIPR_DB_USER=wordpress
RCIPR_DB_PASSWORD=wordpress
RCIPR_DB_ROOT_PASSWORD=root

# --- Dépendance d'adhésions --------------------------------------------------
# free : Restrict Content, téléchargé depuis WordPress.org (défaut, couvre la CI publique).
# pro  : Restrict Content Pro, archive commerciale déposée dans vendor-plugins/.
#        Son archive n'est jamais versionnée (cahier des charges §12.1).
RCP_VARIANT=free
RCP_VERSION=latest

# Variante commerciale : déposez l'archive dans vendor-plugins/, ou désignez un
# répertoire déjà décompressé. Aucune licence n'a besoin d'être activée — le
# plugin fonctionne sans, seule sa mise à jour automatique en dépend.
# RCP_PRO_SOURCE=/chemin/vers/restrict-content-pro
